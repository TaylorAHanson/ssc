AGENT_ENABLED=true

# Database Configuration (Lakebase - PostgreSQL)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=edas_hub
DATABASE_USER=
DATABASE_PASSWORD=

# Databricks Configuration
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_URL=

# Model Serving Configuration (Databricks)
MODEL_SERVING_CLASSIFIER_ENDPOINT=
MODEL_SERVING_AGENT_LLM_ENDPOINT=databricks-gemini-3-flash
MODEL_SERVING_API_KEY=

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=EDAS Hub API

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Poller Settings
POLLER_INTERVAL_SECONDS=5
POLLER_BATCH_SIZE=50
POLLER_MAX_CONCURRENT=10
POLLER_LOCK_TIMEOUT_MINUTES=5
POLLER_LOCK_TIMEOUT_LONG_RUNNING_MINUTES=30
POLLER_HEARTBEAT_INTERVAL_SECONDS=300

# Agent Settings
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60

# Retry Settings
DEFAULT_MAX_RETRIES=3
TERRAFORM_MAX_RETRIES=2
API_MAX_RETRIES=3
DB_MAX_RETRIES=5