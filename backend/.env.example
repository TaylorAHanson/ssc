AGENT_ENABLED=true

# Environment
ENVIRONMENT=development

# Database Configuration (Lakebase - PostgreSQL)
# Optional: For local development against Lakebase, otherwise SQLite is used
DATABASE_HOST=
DATABASE_PASSWORD=

# Databricks Configuration
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_URL=
DATABRICKS_ACCOUNT_ID=""
DATABRICKS_CLIENT_ID=""
DATABRICKS_CLIENT_SECRET=""
DATABRICKS_WAREHOUSE_ID=""
# catalog.schema holding the ADOC *_history tables (adoc_dq_history, etc.).
# Defaults to the real customer env; override for local/dev, e.g.
# DATA_QUALITY_ADOC_SCHEMA="taylor_hanson_build_catalog.main"
DATA_QUALITY_ADOC_SCHEMA=""


# Model Serving Configuration (Databricks)
MODEL_SERVING_CLASSIFIER_ENDPOINT=
MODEL_SERVING_AGENT_LLM_ENDPOINT=databricks-gemini-2-5-flash
MODEL_SERVING_API_KEY=

GITHUB_TOKEN=
GITHUB_ORG=

# Governance Tag Management (GitOps for UC tag changes)
# App opens PRs here; a GitHub Action in the repo applies the ALTER TAGS SQL per env on merge.
GOVERNANCE_TAGS_REPO=
GOVERNANCE_TAGS_BASE_BRANCH=main
GOVERNANCE_TAGS_PATH=tags/migrations

# API Configuration
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Calendar Settings
EVENT_CALENDAR_URL=
EVENT_SYNC_CRON="0 * * * *"
DATA_ASSET_SYNC_CRON="0 * * * *"
ENFORCEMENT_SENTINEL_CRON="*/30 * * * *"

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Poller Settings
POLLER_INTERVAL_SECONDS=5
POLLER_BATCH_SIZE=50
POLLER_MAX_CONCURRENT=10
POLLER_LOCK_TIMEOUT_MINUTES=5
POLLER_LOCK_TIMEOUT_LONG_RUNNING_MINUTES=30
POLLER_HEARTBEAT_INTERVAL_SECONDS=300

# Agent Settings
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
# Agent profiles (authored in the Command Center Agent Studio) may pin a `model`.
# A profile's model is honored ONLY if its serving-endpoint name is listed here
# (comma-separated). Empty = ignore profile models and always use the gateway/
# default routing. "*" allows any endpoint (NOT recommended — bypasses gateway
# guardrails / rate + cost limits).
AGENT_PROFILE_MODEL_ALLOWLIST=

# Open Policy Agent (evaluate_policy tool & Enforcement Sentinel)
# Leave OPA_URL empty and install `opa` on PATH (e.g. brew install opa), or set OPA_BINARY_PATH.
# OPA_URL=http://localhost:8181
OPA_BINARY_PATH=
OPA_POLICIES_DIR=policies

# Retry Settings
DEFAULT_MAX_RETRIES=3
TERRAFORM_MAX_RETRIES=2
API_MAX_RETRIES=3
DB_MAX_RETRIES=5

# Notification Settings (Leave empty to use Mock Mode - prints to logs)
# Email Provider Selection (smtp, ses, mock)
NOTIFICATION_EMAIL_PROVIDER=smtp

# SMTP Settings (used if NOTIFICATION_EMAIL_PROVIDER=smtp)
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_USER=
NOTIFICATION_EMAIL_SMTP_PASSWORD=

# SES Settings (used if NOTIFICATION_EMAIL_PROVIDER=ses)
# Email is sent in-app via boto3. IAM credentials are read from a Databricks
# secret scope (NOT dbutils service credentials). For local dev you can leave
# the secret-scope settings empty and let boto3 use your ambient AWS creds
# (env vars / ~/.aws/credentials / instance profile).
NOTIFICATION_EMAIL_SES_REGION=us-west-2
NOTIFICATION_EMAIL_SES_SOURCE=noreply@databricks.com
NOTIFICATION_EMAIL_SES_SECRET_SCOPE=
NOTIFICATION_EMAIL_SES_ACCESS_KEY_ID_SECRET_KEY=ses-aws-access-key-id
NOTIFICATION_EMAIL_SES_SECRET_ACCESS_KEY_SECRET_KEY=ses-aws-secret-access-key
# Optional: only set if using temporary credentials (STS session token)
NOTIFICATION_EMAIL_SES_SESSION_TOKEN_SECRET_KEY=
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_TEAMS_WEBHOOK_URL=

# Mock User Settings (Local Dev)
MOCK_USER_EMAIL=
MOCK_USER_NAME=
MOCK_USER_ID=

# Confluence doc sync (backend/scripts/sync_docs_to_confluence.py)
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
# CONFLUENCE_SPACE_ID=
# CONFLUENCE_PARENT_PAGE_ID=
# CONFLUENCE_DOCS_DIR=./docs
# CONFLUENCE_VERIFY_SSL=true