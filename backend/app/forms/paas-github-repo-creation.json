{
  "title": "GitHub Repository Creation",
  "description": "Request creation of a new GitHub repository",
  "pages": [
    {
      "name": "page1",
      "elements": [
        {
          "type": "html",
          "name": "sla_info",
          "html": "<div style='background-color: #FFFFFF; border: 1px solid #BFDBFE; border-radius: 0.5rem; padding: 1rem; margin-bottom: 1rem;'><div style='display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;'><svg style='width: 1rem; height: 1rem; color: #2563EB;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg><strong style='color: #111827;'>SLA:</strong></div><p style='color: #374151; margin-left: 1.5rem; margin: 0; font-size: 0.875rem;'>GitHub repository creation is <strong>automated</strong> and usually completes within minutes after submission.</p></div>"
        },
        {
          "type": "radiogroup",
          "name": "scope",
          "title": "Is this just for you, or for a team?",
          "isRequired": true,
          "choices": [
            {"value": "individual", "text": "Just for me"},
            {"value": "team", "text": "For my team"},
            {"value": "multiple", "text": "For multiple teams"}
          ]
        },
        {
          "type": "panel",
          "name": "naming_panel",
          "title": "Repository Naming",
          "elements": [
            {
              "type": "text",
              "name": "domain",
              "title": "Domain",
              "isRequired": true,
              "placeholder": "e.g. mfg, fin, hr"
            },
            {
              "type": "text",
              "name": "team_name",
              "title": "Team Name",
              "isRequired": true,
              "placeholder": "e.g. data-eng, analytics"
            },
            {
              "type": "text",
              "name": "repo_short_name",
              "title": "Repository Short Name",
              "isRequired": true,
              "placeholder": "e.g. demand-forecast"
            },
            {
              "type": "html",
              "name": "name_preview",
              "html": "<div style='background-color: #F9FAFB; border: 1px dashed #D1D5DB; border-radius: 0.5rem; padding: 1rem; margin-top: 1rem;'><span style='color: #6B7280; font-size: 0.875rem;'>Resulting Repository Name:</span><br/><strong style='color: #111827; font-family: monospace;'>{domain}-{team_name}-{repo_short_name}</strong></div>"
            }
          ]
        },
        {
          "type": "dropdown",
          "name": "template",
          "title": "Start from Template",
          "isRequired": true,
          "choices": [
            {"value": "blank", "text": "Blank (Empty Repository)"},
            {"value": "data-engineering", "text": "Data Engineering (dbt + Spark patterns)"},
            {"value": "databricks-apps", "text": "Databricks Apps (Flask/React + SDK)"}
          ],
          "defaultValue": "blank"
        },
        {
          "type": "dropdown",
          "name": "visibility",
          "title": "Repository Visibility",
          "isRequired": true,
          "choices": [
            {"value": "private", "text": "Private"},
            {"value": "internal", "text": "Internal (organization only)"},
            {"value": "public", "text": "Public"}
          ],
          "defaultValue": "private"
        },
        {
          "type": "comment",
          "name": "members",
          "title": "Repository Members",
          "description": "Enter the email addresses of the users who should have access (one per line)",
          "placeholder": "user1@qualcomm.com\nuser2@qualcomm.com"
        },
        {
          "type": "comment",
          "name": "description",
          "title": "Repository Description",
          "description": "Brief description of what this repository will be used for",
          "rows": 3
        },
        {
          "type": "comment",
          "name": "justification",
          "title": "Business Justification",
          "isRequired": true,
          "description": "Please provide a detailed business justification for this repository creation request",
          "rows": 2
        }
      ]
    }
  ]
}
