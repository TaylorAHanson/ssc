{
  "key": "report_execution",
  "name": "report_execution",
  "complete_fact": "distribution_completed",
  "stages": [
    {
      "kind": "step",
      "name": "execute",
      "tool": "execute_report",
      "success_fact": "prompts_executed",
      "writes_context": ["subject", "body"],
      "args": {"prompts": {"$var": {"path": "prompts", "default": []}}}
    },
    {
      "kind": "step",
      "name": "distribute",
      "tool": "send_notification",
      "success_fact": "distribution_completed",
      "args": {
        "subject": {"$var": {"path": "subject", "default": "Report"}},
        "body": {"$var": {"path": "body", "default": ""}},
        "to_email": {"$var": {"path": "subscribers", "default": ""}}
      }
    }
  ]
}
