{
  "key": "enforcement_sentinel",
  "name": "enforcement_sentinel",
  "complete_fact": "notify_completed",
  "stages": [
    {
      "kind": "step",
      "name": "discover",
      "tool": "sentinel_discover",
      "success_fact": "discover_completed",
      "writes_context": ["violations", "checks", "summary"],
      "args": {}
    },
    {
      "kind": "step",
      "name": "enforce",
      "tool": "sentinel_enforce",
      "success_fact": "enforce_completed",
      "writes_context": ["summary"],
      "args": {}
    },
    {
      "kind": "step",
      "name": "notify",
      "tool": "send_notification",
      "success_fact": "notify_completed",
      "args": {
        "subject": "Enforcement Sentinel run complete",
        "body": {"$var": {"path": "summary", "default": "Enforcement Sentinel run complete."}}
      }
    }
  ]
}
