{
  "key": "data_access_request",
  "name": "data_access",
  "stages": [
    {
      "kind": "step",
      "name": "resolve_owners",
      "tool": "resolve_data_owners",
      "running_status": "data_owner_approval",
      "writes_context": ["data_owners"],
      "success_fact": "owners_resolved",
      "args": {
        "assets": {"$var": "assets"},
        "asset_name": {"$var": "asset_name"},
        "asset_type": {"$var": "asset_type"}
      }
    },
    {
      "kind": "gate",
      "name": "manager_approval",
      "type": "manager",
      "waiting_status": "manager_approval",
      "approvers_from": {"$var": "manager_email"}
    },
    {
      "kind": "gate",
      "name": "await_approval",
      "type": "data_owner",
      "waiting_status": "data_owner_approval",
      "approvers_from": {"$var": "data_owners"}
    },
    {
      "kind": "step",
      "name": "provision",
      "tool": "grant_uc_access",
      "approvals": ["manager", "data_owner"],
      "success_fact": "access_granted",
      "for_each": {
        "$coalesce": [
          {"$var": "assets"},
          {"$list": [{"$obj": {"asset_name": {"$var": "asset_name"}, "asset_type": {"$var": "asset_type"}}}]}
        ]
      },
      "item_args": {
        "asset_type": {"$item": "asset_type"},
        "asset_name": {"$item": "asset_name"},
        "principal": {"$var": "requested_by_email"},
        "access_level": {"$var": "access_level"}
      }
    }
  ]
}
